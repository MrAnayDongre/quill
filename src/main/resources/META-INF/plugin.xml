<idea-plugin>
    <id>dev.anay.quill</id>
    <name>Quill</name>
    <vendor>Anay</vendor>
    <description><![CDATA[
        <p>Inline code completion as ghost text, backed by any OpenAI compatible completions endpoint.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <inline.completion.provider implementation="dev.anay.quill.ide.QuillInlineCompletionProvider"/>
        <applicationConfigurable parentId="tools" instance="dev.anay.quill.settings.QuillConfigurable"
                                 id="dev.anay.quill.settings" displayName="Quill"/>
        <statusBarWidgetFactory id="dev.anay.quill.status" implementation="dev.anay.quill.ide.QuillStatusBarFactory"/>
        <notificationGroup id="Quill" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
